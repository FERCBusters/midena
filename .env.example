# -------------------------
# Postgres container bootstrap
# -------------------------
POSTGRES_USER=midena
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD>
POSTGRES_DB=midena

# -------------------------
# API runtime
# -------------------------
MIDENA_DATABASE_URL=postgresql+psycopg://midena:<PASSWORD>@postgres:5432/midena
MIDENA_API_HOST=0.0.0.0
MIDENA_API_PORT=8080
MIDENA_APP_TITLE=MIDENA

# Session / CSRF
MIDENA_SESSION_COOKIE_NAME=midena_session
MIDENA_SESSION_TTL_SECONDS=43200
MIDENA_COOKIE_SECURE=true
MIDENA_COOKIE_SAMESITE=lax
MIDENA_COOKIE_DOMAIN=
MIDENA_CSRF_COOKIE_NAME=midena_csrf
MIDENA_CSRF_HEADER_NAME=X-CSRF-Token
MIDENA_CSRF_COOKIE_SAMESITE=strict

# Post-login redirect allowlist. Same-origin relative paths are always allowed.
MIDENA_LOGIN_REDIRECT_ALLOWED_HOSTS=
# Public external origin used in email links and generated absolute URLs, e.g. https://midena.example.com
MIDENA_PUBLIC_BASE_URL=
MIDENA_TRUST_PROXY_HEADERS=false

# Native local auth. Set false for SSO-only deployments.
MIDENA_LOCAL_AUTH_ENABLED=true

# Optional first-run admin bootstrap. When both username and password are set,
# MIDENA creates this admin account if it does not already exist. Existing users
# are never overwritten. Remove these after the first successful login.
MIDENA_BOOTSTRAP_ADMIN_USERNAME=admin
MIDENA_BOOTSTRAP_ADMIN_PASSWORD=<GENERATE_STRONG_PASSWORD>
MIDENA_BOOTSTRAP_ADMIN_EMAIL=

# Optional trusted upstream identity proxy.
MIDENA_TRUST_REMOTE_USER=false
MIDENA_REMOTE_USER_HEADER_NAME=REMOTE_USER
MIDENA_REMOTE_USER_AUTO_PROVISION=false
MIDENA_REMOTE_USER_AUTO_PROVISION_ROLE=viewer

# Generic OpenID Connect provider.
MIDENA_OIDC_SSO_ENABLED=false
MIDENA_OIDC_PROVIDER_LABEL=OpenID Connect
MIDENA_OIDC_AUTHORIZATION_ENDPOINT=
MIDENA_OIDC_TOKEN_ENDPOINT=
MIDENA_OIDC_JWKS_URI=
MIDENA_OIDC_ISSUER=
MIDENA_OIDC_DISCOVERY_URL=
MIDENA_OIDC_CLIENT_ID=
MIDENA_OIDC_CLIENT_SECRET=
MIDENA_OIDC_SCOPES=openid email profile
# Register this callback with the provider, e.g. https://midena.example.com/v1/auth/oidc/callback
MIDENA_OIDC_REDIRECT_URI=
MIDENA_OIDC_END_SESSION_ENDPOINT=
MIDENA_OIDC_POST_LOGOUT_REDIRECT_URI=
MIDENA_OIDC_ID_TOKEN_LEEWAY_SECONDS=30
MIDENA_OIDC_AUTO_PROVISION=false
MIDENA_OIDC_AUTO_PROVISION_ROLE=viewer
MIDENA_OIDC_AUTO_LINK_EXISTING=true
MIDENA_OIDC_ALLOWED_EMAIL_DOMAINS=
MIDENA_OIDC_USERNAME_CLAIMS=preferred_username,email

# Google OIDC SSO.
MIDENA_GOOGLE_SSO_ENABLED=false
MIDENA_GOOGLE_PROVIDER_LABEL=Google
MIDENA_GOOGLE_CLIENT_ID=
MIDENA_GOOGLE_CLIENT_SECRET=
MIDENA_GOOGLE_SCOPES=openid email profile
MIDENA_GOOGLE_REDIRECT_URI=
MIDENA_GOOGLE_AUTO_PROVISION=false
MIDENA_GOOGLE_AUTO_PROVISION_ROLE=viewer
MIDENA_GOOGLE_AUTO_LINK_EXISTING=true
MIDENA_GOOGLE_ALLOWED_EMAIL_DOMAINS=
MIDENA_GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
MIDENA_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
MIDENA_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
MIDENA_GOOGLE_ISSUER=https://accounts.google.com,accounts.google.com
MIDENA_GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
MIDENA_GOOGLE_USERNAME_CLAIMS=email
MIDENA_GOOGLE_END_SESSION_ENDPOINT=
MIDENA_GOOGLE_POST_LOGOUT_REDIRECT_URI=

# GitHub OAuth SSO.
MIDENA_GITHUB_SSO_ENABLED=false
MIDENA_GITHUB_PROVIDER_LABEL=GitHub
MIDENA_GITHUB_CLIENT_ID=
MIDENA_GITHUB_CLIENT_SECRET=
MIDENA_GITHUB_SCOPES=read:user user:email
MIDENA_GITHUB_REDIRECT_URI=
MIDENA_GITHUB_AUTO_PROVISION=false
MIDENA_GITHUB_AUTO_PROVISION_ROLE=viewer
MIDENA_GITHUB_AUTO_LINK_EXISTING=true
MIDENA_GITHUB_ALLOWED_EMAIL_DOMAINS=
MIDENA_GITHUB_AUTHORIZATION_ENDPOINT=https://github.com/login/oauth/authorize
MIDENA_GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
MIDENA_GITHUB_USER_ENDPOINT=https://api.github.com/user
MIDENA_GITHUB_EMAILS_ENDPOINT=https://api.github.com/user/emails
MIDENA_GITHUB_ISSUER=https://github.com/login/oauth

# SMTP/password reset
MIDENA_SMTP_HOST=
MIDENA_SMTP_PORT=587
MIDENA_SMTP_USERNAME=
MIDENA_SMTP_PASSWORD=
MIDENA_SMTP_USE_TLS=true
MIDENA_SMTP_USE_SSL=false
MIDENA_SMTP_TIMEOUT_SECONDS=20
MIDENA_SMTP_FROM_EMAIL=
MIDENA_SMTP_FROM_NAME=MIDENA
MIDENA_PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Celery/Redis. No scheduled jobs are enabled by default yet, but the service is
# kept to match KEEN/MIDENA deployment topology and future plugin/websocket work.
REDIS_PASSWORD=<GENERATE_STRONG_PASSWORD>
MIDENA_CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
MIDENA_CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1
MIDENA_CELERY_TIMEZONE=UTC

# Google Drive export. Use either a service account JSON string or a mounted JSON
# file path. Delegated user is optional for Workspace domain-wide delegation.
MIDENA_GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
MIDENA_GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
MIDENA_GOOGLE_DRIVE_DELEGATED_USER=
MIDENA_GOOGLE_DRIVE_DEFAULT_FOLDER_ID=

# Optional AI diagram generation. This uses an OpenAI-compatible chat
# completions endpoint from the API service, so the browser never sees the key.
# Regolo.ai is OpenAI-compatible; override the base URL if your endpoint differs.
MIDENA_AI_ENABLED=true
MIDENA_AI_API_BASE_URL=https://api.regolo.ai/v1
MIDENA_AI_API_KEY=
MIDENA_AI_MODEL=
MIDENA_AI_TEMPERATURE=0.2
MIDENA_AI_MAX_TOKENS=2500
MIDENA_AI_TIMEOUT_SECONDS=45
MIDENA_AI_RATE_LIMIT_ATTEMPTS=30
MIDENA_AI_RATE_LIMIT_WINDOW_SECONDS=3600
