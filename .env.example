# -------------------------
# Postgres container bootstrap
# -------------------------
# Required: Compose refuses to start while it is empty. This file ships every
# credential empty, so no installation runs on a value anyone can read here.
# Generate one with: openssl rand -hex 32
POSTGRES_USER=midena
POSTGRES_PASSWORD=
POSTGRES_DB=midena

# -------------------------
# API runtime
# -------------------------
# Follows POSTGRES_* above. A password with characters that are special in a
# URL (such as @ : / ? #) must be percent-encoded here; one made with
# `openssl rand -hex 32` needs no encoding.
MIDENA_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
MIDENA_API_HOST=0.0.0.0
MIDENA_API_PORT=8080


# Session / CSRF
# Secure cookies travel only over HTTPS; turn MIDENA_COOKIE_SECURE off only
# for a local test over plain HTTP. With Secure cookies and no
# MIDENA_COOKIE_DOMAIN, the session, CSRF and sign-in cookies are set with
# the __Host- prefix (__Host-midena_session, __Host-midena_csrf), so a site on
# a sibling subdomain can neither set nor shadow them; give the names here
# without the prefix. The bundled UI reads the CSRF cookie under these names.
MIDENA_SESSION_COOKIE_NAME=midena_session
MIDENA_SESSION_TTL_SECONDS=43200
MIDENA_COOKIE_SECURE=true
MIDENA_COOKIE_SAMESITE=lax
MIDENA_COOKIE_DOMAIN=
MIDENA_CSRF_COOKIE_NAME=midena_csrf
MIDENA_CSRF_HEADER_NAME=X-CSRF-Token
MIDENA_CSRF_COOKIE_SAMESITE=strict

# Trusted proxy networks for forwarded client addresses (comma-separated CIDRs).
# Client addresses used for rate limits and audit records walk X-Forwarded-For
# right-to-left only while every hop is inside these networks; with the setting
# unset, only loopback counts, and internet clients cannot spoof them. Only
# hosts that are append-only forwarding proxies belong here. The trusted
# identity header below has its own list. docker-compose.yml trusts exactly
# the midena-ui container and the network gateway (for a TLS proxy on the
# host) when this is left unset; set it only for another topology. The
# gateway is trusted so that a TLS proxy on the host can pass client
# addresses on: that proxy must append to X-Forwarded-For. A client that
# reaches the published port through the gateway with no such proxy in front
# chooses the address its rate limits and audit rows are recorded under, so
# publish the port to the host proxy alone, or list only the midena-ui
# address here.
# MIDENA_TRUSTED_PROXY_CIDRS=172.30.67.10/32,172.30.67.1/32

# The compose network. Change these where the default subnet clashes with
# another network on the host; the addresses above follow them.
# MIDENA_NETWORK_SUBNET=172.30.67.0/24
# MIDENA_NETWORK_GATEWAY=172.30.67.1
# MIDENA_UI_ADDRESS=172.30.67.10

# Budgets for the worker that sends mail and sweeps expired rows.
# MIDENA_WORKER_MEM_LIMIT=512m
# MIDENA_WORKER_CPUS=1.0

# Post-login redirect allowlist (comma-separated hostnames)
# Same-origin relative paths are always allowed.
# Leave empty to disallow all cross-origin redirects via ?next=.
MIDENA_LOGIN_REDIRECT_ALLOWED_HOSTS=

# Optional trusted upstream identity (Vouch/OIDC proxy)
# Set true ONLY when your network path guarantees the API is reachable through
# the authenticating proxy alone. Only the single configured header below is
# honoured. The supplied nginx clears the client's copies of the names such
# proxies commonly use (REMOTE_USER, Remote-User, X-Remote-User, X-Vouch-User,
# X-Forwarded-User, X-Forwarded-Preferred-Username, X-Forwarded-Email,
# X-Auth-Request-*, X-Authenticated-User, X-Authentik-Username,
# X-Webauth-User) and forwards any other header unchanged: if you set
# MIDENA_REMOTE_USER_HEADER_NAME to a name outside that list, clear or
# overwrite that name in your proxy configuration too.
MIDENA_TRUST_REMOTE_USER=false
MIDENA_REMOTE_USER_HEADER_NAME=REMOTE_USER
# The authenticating proxies whose identity header MIDENA accepts, as
# comma-separated addresses or CIDRs. Required when MIDENA_TRUST_REMOTE_USER
# is true: MIDENA does not start in that mode without it. This list is
# separate from MIDENA_TRUSTED_PROXY_CIDRS, so a hop trusted to forward client
# addresses (the Compose default includes the network gateway, which every
# process on the Docker host connects through) cannot name the signed-in
# account. Name the proxy's own address, for example 172.30.67.10/32.
MIDENA_REMOTE_USER_TRUSTED_CIDRS=

# -------------------------
# Authentication and SSO
# -------------------------
# Native (local) auth login form. Set false to force SSO-only deployments.
MIDENA_LOCAL_AUTH_ENABLED=true

# Local second factor on top of passwords: TOTP authenticator apps,
# security keys/passkeys (WebAuthn) and single-use recovery codes.
# Which local accounts must complete the second factor: optional | admins | all.
MIDENA_MFA_POLICY=optional
# Characters a new local password needs (NIST SP 800-63B-4): 15 where a
# password can be an account's only factor. A value from 8 to 14 is accepted
# only with MIDENA_MFA_POLICY=all. New passwords are also refused when they
# are commonly used, a keyboard or counting sequence, or contain the username.
MIDENA_PASSWORD_MIN_LENGTH=15
# Persistent Fernet key used to encrypt TOTP secrets at rest, e.g. from
# `openssl rand -base64 32`. Keep it in your secrets manager and protected
# backups: enrolment refuses without a valid key, and with a changed key
# existing authenticators cannot verify.
MIDENA_MFA_ENCRYPTION_KEY=

# Optional first administrator, created only while the database holds no
# account at all; remove both values after the first sign-in. The password
# follows the rules above.
MIDENA_BOOTSTRAP_ADMIN_USERNAME=
MIDENA_BOOTSTRAP_ADMIN_PASSWORD=
MIDENA_BOOTSTRAP_ADMIN_EMAIL=

# Public base URL: the origin browsers reach MIDENA at. It is the one origin
# accepted for writes and second-factor ceremonies, and the host of links sent
# by email (SSO email address verification). NEVER derived from request Host
# headers: links sent by email stay off until this is set explicitly.
# e.g. https://midena.example.com
MIDENA_PUBLIC_BASE_URL=

# Generic OpenID Connect provider.
MIDENA_OIDC_SSO_ENABLED=false
MIDENA_OIDC_PROVIDER_LABEL=OpenID Connect

# Explicit OIDC endpoints (recommended; avoids discovery).
# For Ory Hydra these are typically /oauth2/auth and /oauth2/token, and a JWKS URL.
MIDENA_OIDC_AUTHORIZATION_ENDPOINT=
MIDENA_OIDC_TOKEN_ENDPOINT=
MIDENA_OIDC_JWKS_URI=
MIDENA_OIDC_ISSUER=
MIDENA_OIDC_DISCOVERY_URL=
MIDENA_OIDC_CLIENT_ID=
MIDENA_OIDC_CLIENT_SECRET=
MIDENA_OIDC_SCOPES=openid email profile
# Register this callback with the provider, e.g.
# https://midena.example.com/v1/auth/oidc/callback
MIDENA_OIDC_REDIRECT_URI=
MIDENA_OIDC_END_SESSION_ENDPOINT=
MIDENA_OIDC_POST_LOGOUT_REDIRECT_URI=
MIDENA_OIDC_ID_TOKEN_LEEWAY_SECONDS=30
# ID token signing algorithms accepted, space- or comma-separated. Asymmetric
# algorithms only (RS*, PS*, ES*, EdDSA); a shared-secret one refuses sign-in.
MIDENA_OIDC_ALLOWED_ALGS=RS256
MIDENA_OIDC_AUTO_LINK_EXISTING=true
MIDENA_OIDC_ALLOWED_EMAIL_DOMAINS=

# Google OIDC SSO. The defaults work for Google consumer accounts and any
# Google Workspace domain; leave MIDENA_GOOGLE_ALLOWED_EMAIL_DOMAINS empty to
# allow all Workspace domains.
MIDENA_GOOGLE_SSO_ENABLED=false
MIDENA_GOOGLE_PROVIDER_LABEL=Google
MIDENA_GOOGLE_CLIENT_ID=
MIDENA_GOOGLE_CLIENT_SECRET=
MIDENA_GOOGLE_SCOPES=openid email profile
# Register this callback in Google Cloud, e.g.
# https://midena.example.com/v1/auth/sso/google/callback
MIDENA_GOOGLE_REDIRECT_URI=
MIDENA_GOOGLE_AUTO_LINK_EXISTING=true
MIDENA_GOOGLE_ALLOWED_EMAIL_DOMAINS=
# Optional overrides; normally leave these as defaults.
MIDENA_GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
MIDENA_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
MIDENA_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
MIDENA_GOOGLE_ISSUER=https://accounts.google.com,accounts.google.com
MIDENA_GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
MIDENA_GOOGLE_END_SESSION_ENDPOINT=
MIDENA_GOOGLE_POST_LOGOUT_REDIRECT_URI=

# GitHub OAuth SSO. Register this callback in your GitHub OAuth app, e.g.
# https://midena.example.com/v1/auth/sso/github/callback
MIDENA_GITHUB_SSO_ENABLED=false
MIDENA_GITHUB_PROVIDER_LABEL=GitHub
MIDENA_GITHUB_CLIENT_ID=
MIDENA_GITHUB_CLIENT_SECRET=
MIDENA_GITHUB_SCOPES=read:user user:email
MIDENA_GITHUB_REDIRECT_URI=
MIDENA_GITHUB_AUTO_LINK_EXISTING=true
MIDENA_GITHUB_ALLOWED_EMAIL_DOMAINS=
# Optional overrides; normally leave these as defaults.
MIDENA_GITHUB_AUTHORIZATION_ENDPOINT=https://github.com/login/oauth/authorize
MIDENA_GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
MIDENA_GITHUB_USER_ENDPOINT=https://api.github.com/user
MIDENA_GITHUB_EMAILS_ENDPOINT=https://api.github.com/user/emails
MIDENA_GITHUB_ISSUER=https://github.com/login/oauth

# If you want the app to derive redirect URIs from X-Forwarded-* headers,
# enable this ONLY when behind a trusted proxy/ingress.
MIDENA_TRUST_PROXY_HEADERS=false

# -------------------------
# SMTP (password reset emails and admin notifications)
# -------------------------
MIDENA_SMTP_HOST=
MIDENA_SMTP_PORT=587
MIDENA_SMTP_USERNAME=
MIDENA_SMTP_PASSWORD=
MIDENA_SMTP_USE_TLS=true
MIDENA_SMTP_USE_SSL=false
MIDENA_SMTP_TIMEOUT_SECONDS=20
MIDENA_SMTP_FROM_EMAIL=
MIDENA_SMTP_FROM_NAME=MIDENA

# -------------------------
# Celery/Redis
# -------------------------
# Required: Compose refuses to start while it is empty.
# Generate one with: openssl rand -hex 32
REDIS_PASSWORD=

# In docker-compose this points at the bundled Redis container.
MIDENA_CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
MIDENA_CELERY_TIMEZONE=UTC

# How long a worker task may run, in seconds. At a minute before the limit
# the task is told to stop; at the limit its process is replaced.
MIDENA_TASK_TIME_LIMIT_SECONDS=900

# -------------------------
# Installation feature switches
# -------------------------
# Administrators switch these areas on and off on the Administration page
# (Features tab). These settings are the deployment's ceiling: false turns an
# area off entirely whatever the page says (its API routes answer 404 and the
# UI hides its controls), and the page cannot turn it back on.
# Public diagrams: read-only public pages and embeds for diagrams marked
# public. Turning it off withdraws every public link at once.
MIDENA_FEATURE_PUBLIC_DIAGRAMS=true
MIDENA_FEATURE_AI_GENERATION=true
MIDENA_FEATURE_GOOGLE_DRIVE_EXPORT=true

# -------------------------
# Google Drive export (Workspace service account)
# -------------------------
# Exports land in this one folder, named after the diagram; browsers never
# choose the folder or the file's name. Give the service account write access
# to that folder only.
MIDENA_GOOGLE_DRIVE_FOLDER_ID=
# The service account key, as JSON or as the path of a file holding it.
MIDENA_GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
MIDENA_GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Optional Workspace user the service account acts as (domain-wide delegation).
MIDENA_GOOGLE_DRIVE_DELEGATED_USER=
MIDENA_GOOGLE_DRIVE_TIMEOUT_SECONDS=60
MIDENA_GOOGLE_DRIVE_EXPORTS_PER_HOUR=30

# -------------------------
# AI-assisted Mermaid generation (OpenAI-compatible /chat/completions)
# -------------------------
# Off until a key and model are set. The key is used only by the API and is
# never sent to browsers. The base URL must be https:// (plain http is
# accepted only for localhost, for development). Prompts and the current
# diagram source are sent to this provider when a user asks for generation.
MIDENA_AI_API_BASE_URL=https://api.regolo.ai/v1
MIDENA_AI_API_KEY=
MIDENA_AI_MODEL=
MIDENA_AI_TEMPERATURE=0.2
MIDENA_AI_MAX_TOKENS=2500
MIDENA_AI_TIMEOUT_SECONDS=45
# Requests each account may make per window.
MIDENA_AI_RATE_LIMIT_ATTEMPTS=30
MIDENA_AI_RATE_LIMIT_WINDOW_SECONDS=3600
